# Copy to backend/.env and adjust.

# Application
APP_NAME=FlowForge API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
LOG_LEVEL=DEBUG

# Security — ALWAYS change in production!
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ALGORITHM=HS256

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge

# Redis (cache / rate limiting / pub-sub)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Frontend (used by middleware / docs)
FRONTEND_URL=http://localhost:3000
